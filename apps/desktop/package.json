{
  "name": "@sparkclaw/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SparkX Electron desktop runtime and task-scoped browser adapter.",
  "author": "SparkClaw contributors",
  "homepage": "https://github.com/Infinimesh-ai/SparkClaw#readme",
  "license": "Apache-2.0",
  "desktopName": "sparkx",
  "main": "src/main/main.mjs",
  "scripts": {
    "predev": "node ../../scripts/build-iscp-helper.mjs",
    "dev": "electron src/main/main.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser-layout": "node test/run-browser-panel-layout.mjs",
    "qualify": "node test/run-isolated-qualification.mjs",
    "qualify:host": "node test/run-host-native-qualification.mjs",
    "qualify:mac-client": "node test/run-mac-client-native-qualification.mjs",
    "dist:linux-arm64": "electron-builder --linux AppImage deb --arm64 --publish never",
    "dist:mac-arm64": "node scripts/package-macos.mjs --arch arm64",
    "dist:mac-x64": "node scripts/package-macos.mjs --arch x64"
  },
  "dependencies": {
    "@sparkclaw/browser-bridge": "1.0.28"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.infinimesh.sparkclaw",
    "productName": "SparkX",
    "asar": true,
    "afterPack": "./scripts/audit-package.mjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "bin/**/*",
      "!bin/iscp-workbench*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/iscp-workbench",
        "to": "iscp-workbench"
      },
      {
        "from": "../webchat/dist",
        "to": "webchat",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "icon": "src/assets/icon.png",
      "target": [
        { "target": "AppImage", "arch": ["arm64"] },
        { "target": "deb", "arch": ["arm64"] }
      ],
      "category": "Utility",
      "executableName": "sparkx",
      "maintainer": "SparkClaw contributors",
      "vendor": "Infinimesh AI",
      "syncDesktopName": true,
      "artifactName": "SparkX-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "packageName": "sparkclaw",
      "priority": "optional"
    },
    "mac": {
      "icon": "src/assets/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "identity": null,
      "artifactName": "SparkX-${version}-mac-${arch}.${ext}",
      "target": ["dmg", "zip"],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "SparkX uses the microphone only when you start voice input."
      }
    }
  }
}
