{
  "name": "@sparkclaw/webchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 18790",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 18790",
    "test": "npm run lint:i18n && vitest run",
    "lint:i18n": "node scripts/check-i18n-usage.mjs",
    "test:voice": "vitest run src/audio/microphones.test.ts src/audio/pcm16.test.ts src/audio/pcmCapture.test.ts src/audio/realtimeSpeech.test.ts src/audio/silenceDetector.test.ts src/audio/wav.test.ts src/hooks/useVoiceInput.test.tsx src/lib/voiceDraft.test.ts src/lib/voiceState.test.ts"
  },
  "dependencies": {
    "@fortune-sheet/react": "1.0.4",
    "@vitejs/plugin-react": "^6.0.2",
    "highlight.js": "11.12.0",
    "lucide-react": "^0.555.0",
    "pdfjs-dist": "6.3.289",
    "qrcode.react": "4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "10.1.0",
    "react-pdf": "11.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "vitest": "4.1.11"
  }
}
