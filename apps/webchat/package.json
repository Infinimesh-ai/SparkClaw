{
  "name": "@sparkclaw/webchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 18790",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 18790",
    "test": "npm run lint:i18n && vitest run",
    "lint:i18n": "node scripts/check-i18n-usage.mjs",
    "test:voice": "vitest run src/audio/wav.test.ts src/lib/voiceDraft.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16",
    "typescript": "^6.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "lucide-react": "^0.555.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "vitest": "^4.0.18"
  }
}
