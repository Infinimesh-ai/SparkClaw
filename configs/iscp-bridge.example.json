{
  "profile": "production",
  "identity_directory": "../data/iscp-bridge/identity",
  "identity_key_backend": "keyring",
  "identity_keyring_service": "SparkClaw ISCP Bridge",
  "enrollment_file": "../data/iscp-bridge/enrollment.json",
  "permission": "agent.bridge",
  "gateway": {
    "base_url": "http://127.0.0.1:18789",
    "timeout_seconds": 30
  },
  "relay": {
    "reconnect_min_seconds": 1,
    "reconnect_max_seconds": 30,
    "request_timeout_seconds": 30,
    "event_poll_milliseconds": 500,
    "envelope_ttl_seconds": 300
  }
}
