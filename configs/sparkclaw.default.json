{
  "gateway": {
    "bind": "127.0.0.1",
    "port": 18789,
    "pairing_required": false,
    "remote_access": "disabled",
    "rate_limit": {
      "enabled": true,
      "requests_per_minute": 600,
      "burst": 120
    }
  },
  "model": {
    "mock": false,
    "http_timeout_seconds": 300,
    "disable_thinking": true,
    "fast": {
      "name": "sparkclaw-fast",
      "base_url": "https://sparkclaw.infinimesh.cloud/fast/v1",
      "model": "sparkclaw-fast",
      "context_tokens": 12288,
      "mtp": true,
      "max_tokens": 1024
    },
    "deep": {
      "name": "sparkclaw-deep",
      "base_url": "https://sparkclaw.infinimesh.cloud/deep/v1",
      "model": "sparkclaw-deep",
      "context_tokens": 12288,
      "mtp": true,
      "max_tokens": 2048
    },
    "embedding": {
      "name": "sparkclaw-embedding",
      "base_url": "https://sparkclaw.infinimesh.cloud/embedding/v1",
      "model": "sparkclaw-embedding",
      "context_tokens": 32768,
      "mtp": false
    },
    "reranker": {
      "name": "sparkclaw-reranker",
      "base_url": "https://sparkclaw.infinimesh.cloud/reranker/v1",
      "model": "sparkclaw-reranker",
      "context_tokens": 2048,
      "mtp": false
    },
    "guard": {
      "name": "sparkclaw-guard",
      "base_url": "http://127.0.0.1:8005/v1",
      "model": "Qwen/Qwen3Guard-0.6B",
      "context_tokens": 32768,
      "mtp": false
    }
  },
  "speech": {
    "enabled": true,
    "backend": "openai-http",
    "base_url": "https://sparkclaw.infinimesh.cloud/asr",
    "allowed_hosts": ["sparkclaw.infinimesh.cloud"],
    "model": "sparkclaw-asr",
    "default_language": "auto",
    "timeout_seconds": 120,
    "max_audio_seconds": 60,
    "max_upload_bytes": 3145728,
    "max_concurrency": 1,
    "max_pending": 1,
    "retain_audio": false
  },
  "plugins": {
    "entries": {
      "infinimeshInfo": {
        "config": {
          "baseUrl": "https://info.infinimesh.cn",
          "tokenBatchSize": 10,
          "maxAttempts": 3,
          "retryBaseDelayMs": 200,
          "requestTimeoutSeconds": 30,
          "responseBodyMaxBytes": 4194304,
          "language": "zh-CN",
          "maxSources": 8
        }
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": false,
        "provider": "infinimesh-info"
      }
    },
    "browserAutomation": {
      "enabled": false,
      "provider": "microsoft-playwright",
      "profile": "default"
    },
    "reminders": {
      "enabled": true,
      "defaultChannel": "web"
    },
    "notifications": {
      "channels": {
        "weixin": {
          "enabled": false,
          "provider": "openclaw-weixin-qr",
          "baseUrl": "https://ilinkai.weixin.qq.com",
          "cdnBaseUrl": "https://novac2c.cdn.weixin.qq.com/c2c"
        },
        "telegram": {
          "enabled": true,
          "provider": "telegram-bot-api",
          "baseUrl": "https://api.telegram.org",
          "updateMode": "long-polling",
          "pollTimeoutSeconds": 30,
          "privateChatsOnly": true,
          "maxDownloadBytes": 20971520,
          "maxAttachments": 5,
          "maxVoiceSeconds": 120,
          "maxConcurrency": 4,
          "maxPending": 32
        }
      }
    }
  },
  "memory": {
    "enabled": true,
    "write_policy": "candidate_then_confirm",
    "allow_sensitive_memory": false,
    "retention_days": 180,
    "redact_patterns": ["api_key", "password", "token", "ssh_key"]
  },
  "security": {
    "external_content_untrusted": true,
    "approval_required_for_dangerous_tools": true,
    "sandbox_required_for_mutating_tools": true,
    "dangerous_tools_require_deep_verification": true,
    "browser_read_allow_hosts": [],
    "denied_tools": [
      "host_shell.exec",
      "file.delete.permanent",
      "browser.submit_form.auto"
    ]
  },
  "sandbox": {
    "enabled": true,
    "backend": "local-docker",
    "runner_url": "",
    "image": "alpine:3.22",
    "network": "none",
    "workspace_access": "rw",
    "host_access": "forbidden"
  },
  "adapters": {
    "browserAutomation": {
      "nodeCommand": "node",
      "timeoutMs": 30000,
      "chromiumExecutable": "",
      "profileDir": "./data/browser-profiles"
    }
  },
  "workspaces": {
    "default_root": "./data/workspaces",
    "allowlist": ["./data/workspaces"]
  },
  "storage": {
    "trace_dir": "./data/traces",
    "log_dir": "./data/logs",
    "artifact_backend": "filesystem",
    "artifact_dir": "./data/artifacts",
    "artifact_bucket": "sparkclaw",
    "s3_endpoint": "",
    "s3_region": "us-east-1"
  },
  "state": {
    "backend": "file",
    "path": "./data/memory/gateway-state.json",
    "encrypt_at_rest": false,
    "encryption_key": "",
    "encryption_key_file": "",
    "credential_key": "",
    "credential_key_file": "./data/memory/gateway-credentials.key"
  },
  "skills": {
    "dirs": ["./skills", "./data/skills"]
  },
  "runtime": {
    "observation_summary_max_bytes": 2400,
    "react_max_duration_seconds": 180,
    "react_max_tool_calls": 16,
    "react_max_observation_bytes": 48000,
    "react_max_no_progress_actions": 3,
    "react_max_repeated_tool_calls": 3
  },
  "logging": {
    "level": "info",
    "redact_patterns": ["api_key", "password", "token", "ssh_key"]
  }
}
