{
  "gateway": {
    "bind": "127.0.0.1",
    "port": 18789,
    "pairing_required": false,
    "remote_access": "disabled",
    "rate_limit": {
      "enabled": true,
      "requests_per_minute": 600,
      "burst": 120
    }
  },
  "jingsi_lan": {
    "enabled": false,
    "session_id": "",
    "max_message_bytes": 65536
  },
  "model": {
    "capacity_profile": "mock",
    "capacity_catalog": "model.profiles.json",
    "mock": true,
    "http_timeout_seconds": 300,
    "disable_thinking": true,
    "fast": {
      "name": "sparkclaw-fast",
      "base_url": "",
      "model": "sparkclaw-fast",
      "mtp": false
    },
    "deep": {
      "name": "sparkclaw-deep",
      "base_url": "",
      "model": "sparkclaw-deep",
      "mtp": false
    },
    "embedding": {
      "name": "sparkclaw-embedding",
      "base_url": "",
      "model": "sparkclaw-embedding",
      "mtp": false
    },
    "guard": {
      "name": "sparkclaw-guard",
      "base_url": "http://127.0.0.1:8005/v1",
      "model": "Qwen/Qwen3Guard-Gen-0.6B",
      "mtp": false
    }
  },
  "speech": {
    "enabled": false,
    "backend": "openai-http",
    "base_url": "",
    "allowed_hosts": [],
    "model": "sparkclaw-asr",
    "default_language": "auto",
    "timeout_seconds": 120,
    "max_audio_seconds": 60,
    "max_upload_bytes": 3145728,
    "max_concurrency": 1,
    "max_pending": 1,
    "retain_audio": false
  },
  "iscp_pairing": {
    "enabled": false,
    "domain_id": "",
    "authority_url": "",
    "token_env": "",
    "token_file": "",
    "request_timeout_seconds": 15,
    "response_body_max_bytes": 65536,
    "ticket_ttl_seconds": 600,
    "expected_ticket_type": "iscp.pairing_ticket.v2"
  },
  "mcp_access": {
    "local_domain_id": "sparkclaw-local",
    "allowed_origins": []
  },
  "plugins": {
    "entries": {
      "infinimeshInfo": {
        "config": {
          "baseUrl": "https://info.infinimesh.cloud",
          "tokenBatchSize": 10,
          "maxAttempts": 3,
          "retryBaseDelayMs": 200,
          "requestTimeoutSeconds": 30,
          "responseBodyMaxBytes": 4194304,
          "language": "zh-CN",
          "maxSources": 8
        }
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": false,
        "provider": "infinimesh-info"
      }
    },
    "browserAutomation": {
      "enabled": true,
      "provider": "agent-browser",
      "profile": "default"
    },
    "reminders": {
      "enabled": true,
      "defaultChannel": "web",
      "maxDeliveryAttempts": 8
    },
    "notifications": {
      "channels": {
        "weixin": {
          "enabled": false,
          "provider": "openclaw-weixin-qr",
          "baseUrl": "https://ilinkai.weixin.qq.com",
          "cdnBaseUrl": "https://novac2c.cdn.weixin.qq.com/c2c"
        },
        "telegram": {
          "enabled": false,
          "provider": "telegram-bot-api",
          "baseUrl": "https://api.telegram.org",
          "updateMode": "long-polling",
          "pollTimeoutSeconds": 30,
          "privateChatsOnly": true,
          "maxDownloadBytes": 20971520,
          "maxAttachments": 5,
          "maxVoiceSeconds": 120,
          "maxConcurrency": 4,
          "maxPending": 32
        }
      }
    }
  },
  "mcp_servers": {
    "localmind": {
      "transport": "streamable-http",
      "url_env": "LOCALMIND_MCP_URL",
      "bearer_token_env": "LOCALMIND_MCP_TOKEN",
      "namespace": "localmind",
      "expected_server_name": "localmind-ai",
      "protocol_version": "2025-06-18",
      "allow_private_http": false
    }
  },
  "memory": {
    "enabled": true,
    "write_policy": "candidate_then_confirm",
    "allow_sensitive_memory": false,
    "retention_days": 180,
    "redact_patterns": ["api_key", "password", "token", "ssh_key"]
  },
  "passive_notifications": {
    "max_per_owner": 500,
    "retention_days": 90
  },
  "security": {
    "external_content_untrusted": true,
    "approval_required_for_dangerous_tools": true,
    "sandbox_required_for_mutating_tools": true,
    "dangerous_tools_require_deep_verification": true,
    "browser_read_allow_hosts": [],
    "denied_tools": [
      "host_shell.exec",
      "file.delete.permanent",
      "browser.submit_form.auto"
    ]
  },
  "sandbox": {
    "enabled": true,
    "backend": "local-docker",
    "runner_url": "",
    "image": "alpine:3.22",
    "network": "none",
    "workspace_access": "rw",
    "host_access": "forbidden"
  },
  "adapters": {
    "browserAutomation": {
      "command": "agent-browser",
      "timeoutMs": 30000,
      "startupTimeoutMs": 10000,
      "daemonIdleTimeoutMs": 1200000,
      "settleTimeoutMs": 15000,
      "settleQuietPeriodMs": 500,
      "settlePollIntervalMs": 100,
      "routeRebindLimit": 2,
      "chromiumExecutable": "",
      "profileDir": "./data/browser-profiles"
    },
    "documentOCR": {
      "enabled": false,
      "provider": "openai-http",
      "baseUrl": "",
      "allowedHosts": [],
      "model": "sparkclaw-ocr",
      "timeoutSeconds": 120,
      "maxUploadBytes": 12582912,
      "maxOutputBytes": 1048576,
      "maxConcurrency": 2,
      "maxPending": 2
    }
  },
  "workspaces": {
    "default_root": "./data/workspaces",
    "allowlist": ["./data/workspaces"]
  },
  "storage": {
    "trace_dir": "./data/traces",
    "log_dir": "./data/logs",
    "artifact_backend": "filesystem",
    "artifact_dir": "./data/artifacts",
    "artifact_bucket": "sparkclaw",
    "s3_endpoint": "",
    "s3_region": "us-east-1"
  },
  "state": {
    "backend": "file",
    "path": "./data/memory/gateway-state.json",
    "startup_timeout_seconds": 180,
    "read_timeout_seconds": 10,
    "write_timeout_seconds": 30,
    "transaction_timeout_seconds": 60,
    "encrypt_at_rest": false,
    "encryption_key": "",
    "encryption_key_file": "",
    "credential_key": "",
    "credential_key_file": "./data/memory/gateway-credentials.key"
  },
  "runtime": {
    "observation_summary_max_bytes": 2400,
    "workflow_stage_evidence_max_bytes": 8000,
    "workflow_stage_max_duration_seconds": 180,
    "workflow_stage_max_no_progress_actions": 3,
    "workflow_stage_max_observation_reads": 2,
    "workflow_run_max_duration_seconds": 1800,
    "workflow_run_max_tool_calls": 32,
    "workflow_run_observation_compaction_bytes": 36000,
    "workflow_run_max_observation_bytes": 48000,
    "workflow_run_max_repeated_tool_calls": 3
  },
  "logging": {
    "level": "info",
    "redact_patterns": ["api_key", "password", "token", "ssh_key"]
  }
}
