SPARKCLAW_SPEECH_ENABLED=true
SPARKCLAW_SPEECH_BACKEND=openai-http
SPARKCLAW_SPEECH_BASE_URL=http://sparkclaw-asr:8006
SPARKCLAW_SPEECH_ALLOWED_HOSTS=sparkclaw-asr,127.0.0.1,localhost
SPARKCLAW_SPEECH_MODEL=sparkclaw-asr
SPARKCLAW_SPEECH_DEFAULT_LANGUAGE=auto
SPARKCLAW_SPEECH_TIMEOUT_SECONDS=120
SPARKCLAW_SPEECH_MAX_AUDIO_SECONDS=60
SPARKCLAW_SPEECH_MAX_UPLOAD_BYTES=3145728
SPARKCLAW_SPEECH_MAX_CONCURRENCY=1
SPARKCLAW_SPEECH_MAX_PENDING=1
SPARKCLAW_SPEECH_EXPECTED_RUNTIME_VERSION=0.19.2rc1.dev134+gfe9c3d6c5.cu130

SPARKCLAW_ASR_IMAGE=sparkclaw-asr-vllm:cu130-nightly-realtime
SPARKCLAW_ASR_MODEL_ID=Qwen/Qwen3-ASR-0.6B
SPARKCLAW_ASR_SERVED_NAME=sparkclaw-asr
SPARKCLAW_ASR_PORT=8006
SPARKCLAW_ASR_MAX_MODEL_LEN=8192
SPARKCLAW_ASR_GPU_MEMORY_UTILIZATION=0.10
SPARKCLAW_ASR_KV_CACHE_MEMORY_BYTES=2G
SPARKCLAW_ASR_MAX_NUM_SEQS=1
SPARKCLAW_ASR_DTYPE=bfloat16
SPARKCLAW_ASR_VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
SPARKCLAW_ASR_SHM_SIZE=4gb
SPARKCLAW_ASR_STREAMING_CHUNK_SECONDS=1.0
