# Cloud-model server runtime. The VM deployment script copies this file to a
# mode-0600 local env file and fills the private deployment values there.
SPARKCLAW_CONTAINER_UID=1000
SPARKCLAW_CONTAINER_GID=1000
SPARKCLAW_WEBCHAT_BIND=0.0.0.0
SPARKCLAW_WEBCHAT_PORT=18790
SPARKCLAW_API_TOKEN=

SPARKCLAW_WORKSPACE_ROOT=/var/lib/sparkclaw/workspaces
SPARKCLAW_TRACE_DIR=/var/lib/sparkclaw/traces
SPARKCLAW_ARTIFACT_BACKEND=filesystem
SPARKCLAW_ARTIFACT_DIR=/var/lib/sparkclaw/artifacts
SPARKCLAW_ARTIFACT_BUCKET=sparkclaw

SPARKCLAW_STATE_BACKEND=postgres
SPARKCLAW_STATE_DSN=postgres://sparkclaw:sparkclaw@postgres:5432/sparkclaw?sslmode=disable
SPARKCLAW_STATE_STARTUP_TIMEOUT_SECONDS=180
SPARKCLAW_STATE_READ_TIMEOUT_SECONDS=10
SPARKCLAW_STATE_WRITE_TIMEOUT_SECONDS=30
SPARKCLAW_STATE_TRANSACTION_TIMEOUT_SECONDS=60
SPARKCLAW_CREDENTIAL_KEY_FILE=/var/lib/sparkclaw/memory/gateway-credentials.key

SPARKCLAW_SANDBOX_BACKEND=http
SPARKCLAW_SANDBOX_RUNNER_URL=http://sandbox-runner:18889
SPARKCLAW_SANDBOX_NETWORK=none

SPARKCLAW_MODEL_MODE=external
SPARKCLAW_MODEL_HTTP_TIMEOUT_SECONDS=300
SPARKCLAW_MODEL_DISABLE_THINKING=true

SPARKCLAW_FAST_BASE_URL=
SPARKCLAW_FAST_MODEL=sparkclaw-fast
SPARKCLAW_FAST_SERVED_NAME=sparkclaw-fast
SPARKCLAW_FAST_MAX_TOKENS=2048
SPARKCLAW_FAST_CONTEXT_TOKENS=262144
SPARKCLAW_FAST_MAX_INPUT_TOKENS=98304

SPARKCLAW_DEEP_BASE_URL=
SPARKCLAW_DEEP_MODEL=sparkclaw-deep
SPARKCLAW_DEEP_SERVED_NAME=sparkclaw-deep
SPARKCLAW_DEEP_MAX_TOKENS=4096
SPARKCLAW_DEEP_CONTEXT_TOKENS=262144
SPARKCLAW_DEEP_MAX_INPUT_TOKENS=98304

SPARKCLAW_EMBEDDING_BASE_URL=
SPARKCLAW_EMBEDDING_MODEL=sparkclaw-embedding

SPARKCLAW_GUARD_BASE_URL=
SPARKCLAW_GUARD_MODEL=sparkclaw-guard
SPARKCLAW_GUARD_MAX_TOKENS=128
SPARKCLAW_GUARD_CONTEXT_TOKENS=32768

# One complete bounded document extract (200,000 bytes, about 49,700 tokens at
# the hosted endpoint) plus a full 96,000-byte run observation window (about
# 24,000 tokens) and the observed workflow/schema overhead fit inside the
# 98,304-token Gateway input window without context degradation.
SPARKCLAW_WORKFLOW_STAGE_EVIDENCE_MAX_BYTES=200000
SPARKCLAW_WORKFLOW_RUN_OBSERVATION_COMPACTION_BYTES=72000
SPARKCLAW_WORKFLOW_RUN_MAX_OBSERVATION_BYTES=96000

SPARKCLAW_SPEECH_ENABLED=false
SPARKCLAW_SPEECH_BASE_URL=
SPARKCLAW_SPEECH_ALLOWED_HOSTS=
SPARKCLAW_SPEECH_MODEL=sparkclaw-asr

SPARKCLAW_OCR_ENABLED=false
SPARKCLAW_OCR_PROVIDER=openai-http
SPARKCLAW_OCR_BASE_URL=
SPARKCLAW_OCR_ALLOWED_HOSTS=
SPARKCLAW_OCR_MODEL=sparkclaw-ocr
SPARKCLAW_WEB_SEARCH_ENABLED=false
SPARKCLAW_TELEGRAM_ENABLED=false
SPARKCLAW_WEIXIN_NOTIFICATION_ENABLED=false
SPARKCLAW_ISCP_PAIRING_ENABLED=false
SPARKCLAW_JINGSI_LAN_ENABLED=false
