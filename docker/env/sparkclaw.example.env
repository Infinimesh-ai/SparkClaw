SPARKCLAW_BIND=0.0.0.0
SPARKCLAW_PORT=18789
SPARKCLAW_API_TOKEN=
SPARKCLAW_WORKSPACE_ROOT=/var/lib/sparkclaw/workspaces
SPARKCLAW_TRACE_DIR=/var/lib/sparkclaw/traces
SPARKCLAW_ARTIFACT_BACKEND=filesystem
SPARKCLAW_ARTIFACT_DIR=/var/lib/sparkclaw/artifacts
SPARKCLAW_ARTIFACT_BUCKET=sparkclaw
SPARKCLAW_S3_ENDPOINT=http://minio:9000
SPARKCLAW_S3_REGION=us-east-1
SPARKCLAW_S3_ACCESS_KEY=sparkclaw
SPARKCLAW_S3_SECRET_KEY=sparkclaw-local
SPARKCLAW_STATE_BACKEND=file
SPARKCLAW_STATE_PATH=/var/lib/sparkclaw/memory/gateway-state.json
SPARKCLAW_STATE_DSN=postgres://sparkclaw:sparkclaw@postgres:5432/sparkclaw?sslmode=disable
SPARKCLAW_STATE_ENCRYPT_AT_REST=false
SPARKCLAW_STATE_ENCRYPTION_KEY=
SPARKCLAW_STATE_ENCRYPTION_KEY_FILE=
SPARKCLAW_SANDBOX_BACKEND=http
SPARKCLAW_SANDBOX_RUNNER_URL=http://sandbox-runner:18889
SPARKCLAW_SANDBOX_HOST_WORKSPACE_ROOT=./data/workspaces
SPARKCLAW_SANDBOX_CONTAINER_WORKSPACE_ROOT=/var/lib/sparkclaw/workspaces
SPARKCLAW_SANDBOX_IMAGE=alpine:3.22
SPARKCLAW_SANDBOX_NETWORK=none
SPARKCLAW_EMAIL_ADAPTER_BACKEND=file
SPARKCLAW_EMAIL_ADAPTER_URL=
SPARKCLAW_EMAIL_ADAPTER_TOKEN=
SPARKCLAW_CALENDAR_ADAPTER_BACKEND=file
SPARKCLAW_CALENDAR_ADAPTER_URL=
SPARKCLAW_CALENDAR_ADAPTER_TOKEN=
SPARKCLAW_MODEL_MODE=mock
SPARKCLAW_MODEL_HTTP_TIMEOUT_SECONDS=300
SPARKCLAW_MODEL_DISABLE_THINKING=true
SPARKCLAW_VLLM_IMAGE=vllm/vllm-openai:cu130-nightly
SPARKCLAW_VLLM_SHM_SIZE=16gb
SPARKCLAW_MODEL_CACHE=../data/models
HUGGING_FACE_HUB_TOKEN=
SPARKCLAW_FAST_BASE_URL=http://sparkclaw-fast:8001/v1
SPARKCLAW_FAST_MODEL=sparkclaw-fast
SPARKCLAW_FAST_MODEL_ID=Qwen/Qwen3.6-35B-A3B-FP8
SPARKCLAW_FAST_SERVED_NAME=sparkclaw-fast
SPARKCLAW_FAST_MAX_TOKENS=1024
SPARKCLAW_FAST_TENSOR_PARALLEL_SIZE=1
SPARKCLAW_FAST_MAX_MODEL_LEN=131072
SPARKCLAW_FAST_GPU_MEMORY_UTILIZATION=0.82
SPARKCLAW_FAST_SPECULATIVE_CONFIG={"method":"qwen3_next_mtp","num_speculative_tokens":2}
SPARKCLAW_DEEP_BASE_URL=http://sparkclaw-deep:8002/v1
SPARKCLAW_DEEP_MODEL=sparkclaw-deep
SPARKCLAW_DEEP_MODEL_ID=Qwen/Qwen3.6-27B-FP8
SPARKCLAW_DEEP_SERVED_NAME=sparkclaw-deep
SPARKCLAW_DEEP_MAX_TOKENS=2048
SPARKCLAW_DEEP_TENSOR_PARALLEL_SIZE=1
SPARKCLAW_DEEP_MAX_MODEL_LEN=131072
SPARKCLAW_DEEP_GPU_MEMORY_UTILIZATION=0.82
SPARKCLAW_DEEP_SPECULATIVE_CONFIG={"method":"qwen3_next_mtp","num_speculative_tokens":2}
SPARKCLAW_EMBEDDING_BASE_URL=http://sparkclaw-embedding:8003/v1
SPARKCLAW_EMBEDDING_MODEL=sparkclaw-embedding
SPARKCLAW_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
SPARKCLAW_EMBEDDING_SERVED_NAME=sparkclaw-embedding
SPARKCLAW_EMBEDDING_MAX_MODEL_LEN=32768
SPARKCLAW_EMBEDDING_GPU_MEMORY_UTILIZATION=0.12
SPARKCLAW_RERANKER_BASE_URL=http://sparkclaw-reranker:8004/v1
SPARKCLAW_RERANKER_MODEL=sparkclaw-reranker
SPARKCLAW_RERANKER_MODEL_ID=Qwen/Qwen3-Reranker-0.6B
SPARKCLAW_RERANKER_SERVED_NAME=sparkclaw-reranker
SPARKCLAW_RERANKER_RUNNER=auto
SPARKCLAW_RERANKER_CONVERT=auto
SPARKCLAW_RERANKER_MAX_MODEL_LEN=2048
SPARKCLAW_RERANKER_GPU_MEMORY_UTILIZATION=0.12
SPARKCLAW_GUARD_BASE_URL=http://sparkclaw-guard:8005/v1
SPARKCLAW_GUARD_MODEL=Qwen/Qwen3Guard-0.6B
SPARKCLAW_BROWSER_READ_ALLOW_HOSTS=
SPARKCLAW_TOOLS_POLICY_PATH=/var/lib/sparkclaw/memory/tools.policy.json
SPARKCLAW_EVALUATOR_GATEWAY_URL=http://gateway:18789
SPARKCLAW_EVALUATOR_PROFILE=api-smoke
SPARKCLAW_EVALUATOR_OUTPUT=/reports/evaluator-report.json
SPARKCLAW_EVALUATOR_CONFIG=/app/configs/eval.profiles.json
VITE_SPARKCLAW_API_BASE=http://127.0.0.1:18789
VITE_SPARKCLAW_API_TOKEN=
