SPARKCLAW_S3_REGION=us-east-1
SPARKCLAW_S3_ACCESS_KEY=sparkclaw
SPARKCLAW_S3_SECRET_KEY=sparkclaw-local
SPARKCLAW_STATE_BACKEND=file
SPARKCLAW_STATE_PATH=/var/lib/sparkclaw/memory/gateway-state.json
SPARKCLAW_STATE_DSN=postgres://sparkclaw:sparkclaw@postgres:5432/sparkclaw?sslmode=disable
SPARKCLAW_STATE_ENCRYPT_AT_REST=false
SPARKCLAW_STATE_ENCRYPTION_KEY=
SPARKCLAW_STATE_ENCRYPTION_KEY_FILE=
SPARKCLAW_CREDENTIAL_KEY=
SPARKCLAW_CREDENTIAL_KEY_FILE=./data/memory/gateway-credentials.key
SPARKCLAW_WEIXIN_NOTIFICATION_ENABLED=false
