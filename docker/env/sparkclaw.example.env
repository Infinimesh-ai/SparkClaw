SPARKCLAW_SPEECH_DEFAULT_LANGUAGE=auto
SPARKCLAW_SPEECH_TIMEOUT_SECONDS=120
SPARKCLAW_SPEECH_MAX_AUDIO_SECONDS=60
SPARKCLAW_SPEECH_MAX_UPLOAD_BYTES=3145728
SPARKCLAW_SPEECH_MAX_CONCURRENCY=1
SPARKCLAW_SPEECH_MAX_PENDING=1
SPARKCLAW_SPEECH_EXPECTED_RUNTIME_VERSION=0.24.0
# External MCP device pairing remains off until a real ISCP authority adapter
# endpoint is deployed. The authority token authorizes SparkClaw to request a
# standard Pairing Ticket; it is not the ticket shown to the external device.
SPARKCLAW_ISCP_PAIRING_ENABLED=false
SPARKCLAW_ISCP_DOMAIN_ID=
SPARKCLAW_ISCP_AUTHORITY_URL=
SPARKCLAW_ISCP_AUTHORITY_TOKEN_ENV=SPARKCLAW_ISCP_AUTHORITY_TOKEN
SPARKCLAW_ISCP_AUTHORITY_TOKEN_FILE=
SPARKCLAW_ISCP_AUTHORITY_TOKEN=
# Direct LAN MCP uses the WebChat ingress at /mcp. Gateway remains internal to
# Docker; WebChat independently controls ISCP and direct LAN ingress.
SPARKCLAW_MCP_LOCAL_DOMAIN_ID=sparkclaw-local
LOCALMIND_MCP_URL=
LOCALMIND_MCP_TOKEN=
SPARKCLAW_OCR_ENABLED=false
SPARKCLAW_OCR_PROVIDER=openai-http
SPARKCLAW_OCR_BASE_URL=
SPARKCLAW_OCR_ALLOWED_HOSTS=
SPARKCLAW_OCR_MODEL=sparkclaw-ocr
SPARKCLAW_OCR_TIMEOUT_SECONDS=120
SPARKCLAW_OCR_MAX_UPLOAD_BYTES=12582912
SPARKCLAW_OCR_MAX_OUTPUT_BYTES=1048576
SPARKCLAW_OCR_MAX_TOKENS=16384
SPARKCLAW_OCR_MAX_CONCURRENCY=2
SPARKCLAW_OCR_MAX_PENDING=2
