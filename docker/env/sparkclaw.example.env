SPARKCLAW_TELEGRAM_POLL_TIMEOUT_SECONDS=30
SPARKCLAW_TELEGRAM_MAX_DOWNLOAD_BYTES=20971520
SPARKCLAW_TELEGRAM_MAX_ATTACHMENTS=5
SPARKCLAW_TELEGRAM_MAX_VOICE_SECONDS=120
SPARKCLAW_TELEGRAM_MAX_CONCURRENCY=4
SPARKCLAW_TELEGRAM_MAX_PENDING=32
SPARKCLAW_SANDBOX_BACKEND=http
SPARKCLAW_SANDBOX_RUNNER_URL=http://sandbox-runner:18889
SPARKCLAW_SANDBOX_HOST_WORKSPACE_ROOT=./data/workspaces
SPARKCLAW_SANDBOX_CONTAINER_WORKSPACE_ROOT=/var/lib/sparkclaw/workspaces
SPARKCLAW_SANDBOX_IMAGE=alpine:3.22
SPARKCLAW_SANDBOX_NETWORK=none
SPARKCLAW_MODEL_MODE=external
SPARKCLAW_MODEL_HTTP_TIMEOUT_SECONDS=300
SPARKCLAW_MODEL_DISABLE_THINKING=true
SPARKCLAW_SPEECH_ENABLED=false
SPARKCLAW_SPEECH_BACKEND=openai-http
SPARKCLAW_SPEECH_BASE_URL=
