# Versioned Local model wiring and model-container infrastructure. Shared
# product behavior lives in sparkclaw.product.env; secrets and host overrides
# live in ../../.env.local.
SPARKCLAW_DEPLOYMENT_PROFILE=local
SPARKCLAW_AUTOSTART_ENABLED=true
SPARKCLAW_AUTOSTART_READY_TIMEOUT_SECONDS=600
SPARKCLAW_AUTOSTART_PROBE_TIMEOUT_SECONDS=10
SPARKCLAW_FORCE_MODEL_RECREATE=false

SPARKCLAW_FAST_BASE_URL=http://sparkclaw-fast:8001/v1
SPARKCLAW_FAST_MODEL_ID=nvidia/Qwen3.6-35B-A3B-NVFP4
SPARKCLAW_FAST_TENSOR_PARALLEL_SIZE=1
SPARKCLAW_FAST_GPU_MEMORY_UTILIZATION=0.42
SPARKCLAW_FAST_KV_CACHE_MEMORY_BYTES=8G
SPARKCLAW_FAST_MAX_NUM_SEQS=4
SPARKCLAW_FAST_SPECULATIVE_TOKENS=0
SPARKCLAW_FAST_SPECULATIVE_CONFIG=

SPARKCLAW_DEEP_BASE_URL=http://sparkclaw-fast:8001/v1
SPARKCLAW_DEEP_MODEL_ID=nvidia/Qwen3.6-35B-A3B-NVFP4
SPARKCLAW_DEEP_TENSOR_PARALLEL_SIZE=1
SPARKCLAW_DEEP_GPU_MEMORY_UTILIZATION=0.36
SPARKCLAW_DEEP_KV_CACHE_MEMORY_BYTES=12G
SPARKCLAW_DEEP_MAX_NUM_SEQS=2
SPARKCLAW_DEEP_SPECULATIVE_TOKENS=0
SPARKCLAW_DEEP_SPECULATIVE_CONFIG=

SPARKCLAW_EMBEDDING_BASE_URL=http://sparkclaw-embedding:8003/v1
SPARKCLAW_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
SPARKCLAW_EMBEDDING_GPU_MEMORY_UTILIZATION=0.06
SPARKCLAW_EMBEDDING_KV_CACHE_MEMORY_BYTES=2G
SPARKCLAW_EMBEDDING_MAX_NUM_SEQS=128

SPARKCLAW_GUARD_BASE_URL=http://sparkclaw-guard:8005/v1
SPARKCLAW_GUARD_MODEL_ID=Qwen/Qwen3Guard-Gen-0.6B
SPARKCLAW_GUARD_GPU_MEMORY_UTILIZATION=0.04
SPARKCLAW_GUARD_KV_CACHE_MEMORY_BYTES=2G
SPARKCLAW_GUARD_MAX_NUM_SEQS=1

SPARKCLAW_SPEECH_BASE_URL=http://sparkclaw-asr:8006
SPARKCLAW_SPEECH_ALLOWED_HOSTS=sparkclaw-asr,127.0.0.1,localhost
SPARKCLAW_SPEECH_EXPECTED_RUNTIME_VERSION=0.19.2rc1.dev134+gfe9c3d6c5.cu130
SPARKCLAW_ASR_IMAGE=sparkclaw-asr-vllm:cu130-nightly-realtime
SPARKCLAW_ASR_MODEL_ID=Qwen/Qwen3-ASR-0.6B
SPARKCLAW_ASR_PORT=8006
SPARKCLAW_ASR_MAX_MODEL_LEN=8192
SPARKCLAW_ASR_GPU_MEMORY_UTILIZATION=0.10
SPARKCLAW_ASR_KV_CACHE_MEMORY_BYTES=2G
SPARKCLAW_ASR_MAX_NUM_SEQS=1
SPARKCLAW_ASR_DTYPE=bfloat16
SPARKCLAW_ASR_VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
SPARKCLAW_ASR_SHM_SIZE=4gb
SPARKCLAW_ASR_STREAMING_CHUNK_SECONDS=1.0

SPARKCLAW_OCR_BASE_URL=http://sparkclaw-ocr:8007/v1
SPARKCLAW_OCR_ALLOWED_HOSTS=sparkclaw-ocr,127.0.0.1,localhost
SPARKCLAW_OCR_IMAGE=vllm/vllm-openai:v0.22.1
SPARKCLAW_OCR_MODEL_ID=ATH-MaaS/OvisOCR2
SPARKCLAW_OCR_PORT=8007
SPARKCLAW_OCR_GPU_MEMORY_UTILIZATION=0.12
SPARKCLAW_OCR_KV_CACHE_MEMORY_BYTES=2G
SPARKCLAW_OCR_MAX_NUM_SEQS=2

SPARKCLAW_VLLM_IMAGE=vllm/vllm-openai:cu130-nightly
SPARKCLAW_CHAT_VLLM_IMAGE=vllm/vllm-openai:v0.24.0
SPARKCLAW_VLLM_SHM_SIZE=16gb
SPARKCLAW_MODEL_CACHE=../data/models
