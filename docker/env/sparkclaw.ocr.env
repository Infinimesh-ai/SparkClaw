SPARKCLAW_OCR_ENABLED=true
SPARKCLAW_OCR_PROVIDER=openai-http
SPARKCLAW_OCR_BASE_URL=http://sparkclaw-ocr:8007/v1
SPARKCLAW_OCR_ALLOWED_HOSTS=sparkclaw-ocr,127.0.0.1,localhost
SPARKCLAW_OCR_MODEL=sparkclaw-ocr
SPARKCLAW_OCR_TIMEOUT_SECONDS=120
SPARKCLAW_OCR_MAX_UPLOAD_BYTES=12582912
SPARKCLAW_OCR_MAX_OUTPUT_BYTES=1048576
SPARKCLAW_OCR_MAX_CONCURRENCY=2
SPARKCLAW_OCR_MAX_PENDING=2
SPARKCLAW_OCR_KV_CACHE_MEMORY_BYTES=2G
