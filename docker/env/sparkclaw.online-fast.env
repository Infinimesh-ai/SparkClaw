# Hosted chat profile for the DGX Spark runtime. Fast and Deep use the hosted
# endpoint; embedding, guard, ASR, and OCR remain on the local model network.
SPARKCLAW_MODEL_MODE=external
SPARKCLAW_MODEL_CAPACITY_PROFILE=infinimesh-online-fast-v1
SPARKCLAW_STATE_BACKEND=postgres
SPARKCLAW_STATE_DSN=postgres://sparkclaw:sparkclaw@postgres:5432/sparkclaw?sslmode=disable
SPARKCLAW_MODEL_DISABLE_THINKING=true
SPARKCLAW_MODEL_HTTP_TIMEOUT_SECONDS=300

SPARKCLAW_FAST_BASE_URL=https://sparkclaw.infinimesh.cloud/fast/v1
SPARKCLAW_FAST_MODEL=sparkclaw-fast
SPARKCLAW_FAST_SERVED_NAME=sparkclaw-fast

# Preserve the logical Deep lane while serving it from hosted Fast.
SPARKCLAW_DEEP_BASE_URL=https://sparkclaw.infinimesh.cloud/fast/v1
SPARKCLAW_DEEP_MODEL=sparkclaw-fast
SPARKCLAW_DEEP_SERVED_NAME=sparkclaw-deep

SPARKCLAW_EMBEDDING_BASE_URL=http://sparkclaw-embedding:8003/v1
SPARKCLAW_EMBEDDING_MODEL=sparkclaw-embedding
SPARKCLAW_GUARD_BASE_URL=http://sparkclaw-guard:8005/v1
SPARKCLAW_GUARD_MODEL=Qwen/Qwen3Guard-Gen-0.6B

SPARKCLAW_WORKFLOW_STAGE_EVIDENCE_MAX_BYTES=200000
SPARKCLAW_WORKFLOW_RUN_OBSERVATION_COMPACTION_BYTES=72000
SPARKCLAW_WORKFLOW_RUN_MAX_OBSERVATION_BYTES=96000

SPARKCLAW_BROWSER_READ_ALLOW_HOSTS=host.docker.internal
