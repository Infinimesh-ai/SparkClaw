# Versioned product contract shared by Local and Remote. Mode profiles may
# choose model endpoints and local model infrastructure only; private files
# contain credentials and machine-specific overrides.
SPARKCLAW_BIND=0.0.0.0
SPARKCLAW_PORT=18789
SPARKCLAW_WEBCHAT_BIND=0.0.0.0
SPARKCLAW_WEBCHAT_PORT=18790
SPARKCLAW_API_TOKEN=
SPARKCLAW_PAIRING_REQUIRED=true

SPARKCLAW_WORKSPACE_ROOT=/var/lib/sparkclaw/workspaces
SPARKCLAW_TRACE_DIR=/var/lib/sparkclaw/traces
SPARKCLAW_ARTIFACT_BACKEND=filesystem
SPARKCLAW_ARTIFACT_DIR=/var/lib/sparkclaw/artifacts
SPARKCLAW_ARTIFACT_BUCKET=sparkclaw
SPARKCLAW_S3_ENDPOINT=http://minio:9000
SPARKCLAW_S3_REGION=us-east-1
SPARKCLAW_S3_ACCESS_KEY=sparkclaw
SPARKCLAW_S3_SECRET_KEY=sparkclaw-local

SPARKCLAW_STATE_BACKEND=postgres
SPARKCLAW_STATE_PATH=/var/lib/sparkclaw/memory/gateway-state.json
SPARKCLAW_STATE_DSN=postgres://sparkclaw:sparkclaw@postgres:5432/sparkclaw?sslmode=disable
SPARKCLAW_STATE_STARTUP_TIMEOUT_SECONDS=180
SPARKCLAW_STATE_READ_TIMEOUT_SECONDS=10
SPARKCLAW_STATE_WRITE_TIMEOUT_SECONDS=30
SPARKCLAW_STATE_TRANSACTION_TIMEOUT_SECONDS=60
SPARKCLAW_STATE_ENCRYPT_AT_REST=false
SPARKCLAW_STATE_ENCRYPTION_KEY=
SPARKCLAW_STATE_ENCRYPTION_KEY_FILE=
SPARKCLAW_CREDENTIAL_KEY=
SPARKCLAW_CREDENTIAL_KEY_FILE=/var/lib/sparkclaw/memory/gateway-credentials.key

SPARKCLAW_JINGSI_LAN_ENABLED=false
SPARKCLAW_JINGSI_LAN_BIND=
SPARKCLAW_JINGSI_LAN_PORT=18793
SPARKCLAW_JINGSI_SESSION_ID=
SPARKCLAW_JINGSI_MAX_MESSAGE_BYTES=65536
SPARKCLAW_WEIXIN_NOTIFICATION_ENABLED=false
SPARKCLAW_TELEGRAM_ENABLED=false
SPARKCLAW_TELEGRAM_BASE_URL=https://api.telegram.org
SPARKCLAW_TELEGRAM_POLL_TIMEOUT_SECONDS=30
SPARKCLAW_TELEGRAM_MAX_DOWNLOAD_BYTES=20971520
SPARKCLAW_TELEGRAM_MAX_ATTACHMENTS=5
SPARKCLAW_TELEGRAM_MAX_VOICE_SECONDS=120
SPARKCLAW_TELEGRAM_MAX_CONCURRENCY=4
SPARKCLAW_TELEGRAM_MAX_PENDING=32

SPARKCLAW_SANDBOX_BACKEND=http
SPARKCLAW_SANDBOX_RUNNER_URL=http://sandbox-runner:18889
SPARKCLAW_SANDBOX_HOST_WORKSPACE_ROOT=./data/workspaces
SPARKCLAW_SANDBOX_CONTAINER_WORKSPACE_ROOT=/var/lib/sparkclaw/workspaces
SPARKCLAW_SANDBOX_IMAGE=alpine:3.22
SPARKCLAW_SANDBOX_NETWORK=none

SPARKCLAW_MODEL_MODE=external
SPARKCLAW_MODEL_CAPACITY_PROFILE=sparkclaw-product-v1
SPARKCLAW_MODEL_HTTP_TIMEOUT_SECONDS=300
SPARKCLAW_MODEL_DISABLE_THINKING=true
SPARKCLAW_FAST_MODEL=sparkclaw-fast
SPARKCLAW_FAST_SERVED_NAME=sparkclaw-fast
SPARKCLAW_DEEP_MODEL=sparkclaw-fast
SPARKCLAW_DEEP_SERVED_NAME=sparkclaw-deep
SPARKCLAW_EMBEDDING_MODEL=sparkclaw-embedding
SPARKCLAW_EMBEDDING_SERVED_NAME=sparkclaw-embedding
SPARKCLAW_GUARD_MODEL=sparkclaw-guard
SPARKCLAW_GUARD_SERVED_NAME=sparkclaw-guard

SPARKCLAW_WORKFLOW_STAGE_EVIDENCE_MAX_BYTES=200000
SPARKCLAW_WORKFLOW_RUN_OBSERVATION_COMPACTION_BYTES=72000
SPARKCLAW_WORKFLOW_RUN_MAX_OBSERVATION_BYTES=96000

SPARKCLAW_SPEECH_ENABLED=true
SPARKCLAW_SPEECH_BACKEND=openai-http
SPARKCLAW_SPEECH_MODEL=sparkclaw-asr
SPARKCLAW_ASR_SERVED_NAME=sparkclaw-asr
SPARKCLAW_SPEECH_DEFAULT_LANGUAGE=auto
SPARKCLAW_SPEECH_TIMEOUT_SECONDS=120
SPARKCLAW_SPEECH_MAX_AUDIO_SECONDS=60
SPARKCLAW_SPEECH_MAX_UPLOAD_BYTES=3145728
SPARKCLAW_SPEECH_MAX_CONCURRENCY=1
SPARKCLAW_SPEECH_MAX_PENDING=1

SPARKCLAW_ISCP_PAIRING_ENABLED=false
SPARKCLAW_ISCP_DOMAIN_ID=
SPARKCLAW_ISCP_AUTHORITY_URL=
SPARKCLAW_ISCP_AUTHORITY_TOKEN_ENV=SPARKCLAW_ISCP_AUTHORITY_TOKEN
SPARKCLAW_ISCP_AUTHORITY_TOKEN_FILE=
SPARKCLAW_ISCP_AUTHORITY_TOKEN=
SPARKCLAW_MCP_LOCAL_DOMAIN_ID=sparkclaw-local
LOCALMIND_MCP_URL=
LOCALMIND_MCP_TOKEN=

SPARKCLAW_OCR_ENABLED=true
SPARKCLAW_OCR_PROVIDER=openai-http
SPARKCLAW_OCR_MODEL=sparkclaw-ocr
SPARKCLAW_OCR_SERVED_NAME=sparkclaw-ocr
SPARKCLAW_OCR_TIMEOUT_SECONDS=120
SPARKCLAW_OCR_MAX_UPLOAD_BYTES=12582912
SPARKCLAW_OCR_MAX_OUTPUT_BYTES=1048576
SPARKCLAW_OCR_MAX_CONCURRENCY=2
SPARKCLAW_OCR_MAX_PENDING=2

SPARKCLAW_PPTX_VISUAL_QA_PHASE=shadow
SPARKCLAW_PPTX_VISUAL_QA_REPAIR_QUALIFIED_CLASSES=
SPARKCLAW_PPTX_VISUAL_QA_REPAIR_QUALIFIED_OPERATIONS=
SPARKCLAW_PPTX_VISUAL_QA_BLOCKING_QUALIFIED_CLASSES=
SPARKCLAW_PPTX_VISUAL_QA_MAX_REPAIR_ATTEMPTS=2
SPARKCLAW_PPTX_VISUAL_QA_BASE_URL=http://gotenberg:3000
SPARKCLAW_PPTX_VISUAL_QA_ALLOWED_HOSTS=gotenberg
SPARKCLAW_PPTX_VISUAL_QA_TIMEOUT_SECONDS=120
SPARKCLAW_PPTX_VISUAL_QA_MAX_INPUT_BYTES=67108864
SPARKCLAW_PPTX_VISUAL_QA_MAX_PDF_BYTES=67108864
SPARKCLAW_PPTX_VISUAL_QA_MAX_PAGES=100
SPARKCLAW_PPTX_VISUAL_QA_MAX_CHANGED_PAGES=20
SPARKCLAW_PPTX_VISUAL_QA_RASTER_SCALE=1.5
SPARKCLAW_PPTX_VISUAL_QA_MAX_PAGE_PIXELS=20000000
SPARKCLAW_PPTX_VISUAL_QA_MAX_PNG_BYTES=12582912
SPARKCLAW_PPTX_VISUAL_QA_DIAGNOSTIC_TOLERANCE_MILLI=2
SPARKCLAW_PPTX_VISUAL_QA_READINESS_TTL_SECONDS=300

SPARKCLAW_WEB_SEARCH_ENABLED=false
SPARKCLAW_WEB_SEARCH_PROVIDER=infinimesh-info
SPARKCLAW_INFINIMESH_INFO_BASE_URL=https://info.infinimesh.cloud
SPARKCLAW_INFINIMESH_INFO_TOKEN_BATCH_SIZE=10
SPARKCLAW_INFINIMESH_INFO_MAX_ATTEMPTS=3
SPARKCLAW_INFINIMESH_INFO_RETRY_BASE_DELAY_MS=200
SPARKCLAW_INFINIMESH_INFO_REQUEST_TIMEOUT_SECONDS=30
SPARKCLAW_INFINIMESH_INFO_RESPONSE_BODY_MAX_BYTES=4194304
SPARKCLAW_INFINIMESH_INFO_LANGUAGE=zh-CN
SPARKCLAW_INFINIMESH_INFO_MAX_SOURCES=8
SPARKCLAW_INFINIMESH_INFO_LICENSE_ID=
SPARKCLAW_INFINIMESH_INFO_LICENSE_KEY=
SPARKCLAW_INFINIMESH_INFO_LICENSE_KEY_FILE=

SPARKCLAW_BROWSER_READ_ALLOW_HOSTS=
SPARKCLAW_BROWSER_AUTOMATION_TIMEOUT_MS=30000
SPARKCLAW_BROWSER_AUTOMATION_STARTUP_TIMEOUT_MS=10000
SPARKCLAW_BROWSER_AUTOMATION_SETTLE_TIMEOUT_MS=15000
SPARKCLAW_BROWSER_AUTOMATION_SETTLE_QUIET_PERIOD_MS=500
SPARKCLAW_BROWSER_AUTOMATION_SETTLE_POLL_INTERVAL_MS=100
SPARKCLAW_BROWSER_AUTOMATION_ROUTE_REBIND_LIMIT=2
SPARKCLAW_BROWSER_EXTENSION_RUNTIME_DIR_HOST=/run/user/1000/sparkclaw/browser-controller
SPARKCLAW_BROWSER_EXTENSION_CONTROLLER_SOCKET=/run/sparkclaw/browser-controller/controller.sock
SPARKCLAW_BROWSER_EXTENSION_CONTROLLER_SOCKET_HOST=/run/user/1000/sparkclaw/browser-controller/controller.sock
SPARKCLAW_BROWSER_EXTENSION_PROFILE_ID=default
SPARKCLAW_BROWSER_EXTENSION_CONNECT_TIMEOUT_MS=20000
SPARKCLAW_TOOLS_POLICY_PATH=/var/lib/sparkclaw/memory/tools.policy.json

SPARKCLAW_EVALUATOR_GATEWAY_URL=http://gateway:18789
SPARKCLAW_EVALUATOR_PROFILE=api-smoke
SPARKCLAW_EVALUATOR_OUTPUT=/reports/evaluator-report.json
SPARKCLAW_EVALUATOR_CONFIG=/app/configs/eval.profiles.json
