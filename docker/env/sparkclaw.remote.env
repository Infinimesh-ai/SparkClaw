# Versioned Remote model wiring. Shared product behavior lives in
# sparkclaw.product.env; credentials and host overrides live in ../../.env.remote.
SPARKCLAW_DEPLOYMENT_PROFILE=remote

SPARKCLAW_FAST_BASE_URL=https://sparkclaw.infinimesh.cloud/fast/v1

SPARKCLAW_DEEP_BASE_URL=https://sparkclaw.infinimesh.cloud/fast/v1

SPARKCLAW_EMBEDDING_BASE_URL=https://sparkclaw.infinimesh.cloud/embedding/v1

SPARKCLAW_GUARD_BASE_URL=https://sparkclaw.infinimesh.cloud/guard/v1

SPARKCLAW_SPEECH_BASE_URL=https://sparkclaw.infinimesh.cloud/asr
SPARKCLAW_SPEECH_ALLOWED_HOSTS=sparkclaw.infinimesh.cloud

SPARKCLAW_OCR_BASE_URL=https://sparkclaw.infinimesh.cloud/ocr/v1
SPARKCLAW_OCR_ALLOWED_HOSTS=sparkclaw.infinimesh.cloud
