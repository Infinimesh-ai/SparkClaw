SPARKCLAW_MODEL_MODE=external
SPARKCLAW_STATE_BACKEND=postgres
SPARKCLAW_STATE_DSN=postgres://sparkclaw:sparkclaw@postgres:5432/sparkclaw?sslmode=disable
SPARKCLAW_MODEL_DISABLE_THINKING=true
SPARKCLAW_MODEL_HTTP_TIMEOUT_SECONDS=300

SPARKCLAW_CHAT_VLLM_IMAGE=vllm/vllm-openai:v0.24.0

SPARKCLAW_FAST_BASE_URL=http://sparkclaw-fast:8001/v1
SPARKCLAW_FAST_MODEL=sparkclaw-fast
SPARKCLAW_FAST_MODEL_ID=nvidia/Qwen3.6-35B-A3B-NVFP4
SPARKCLAW_FAST_SERVED_NAME=sparkclaw-fast
SPARKCLAW_FAST_MAX_TOKENS=768
SPARKCLAW_FAST_CONTEXT_TOKENS=32768
SPARKCLAW_FAST_MAX_INPUT_TOKENS=0
SPARKCLAW_FAST_MAX_MODEL_LEN=32768
SPARKCLAW_FAST_GPU_MEMORY_UTILIZATION=0.42
SPARKCLAW_FAST_KV_CACHE_MEMORY_BYTES=8G
SPARKCLAW_FAST_MAX_NUM_SEQS=4
SPARKCLAW_FAST_SPECULATIVE_TOKENS=0
SPARKCLAW_FAST_SPECULATIVE_CONFIG=

# Keep the logical deep profile for workflow compatibility, but serve it with
# the same Fast endpoint and model. No Deep model process is required.
SPARKCLAW_DEEP_BASE_URL=http://sparkclaw-fast:8001/v1
SPARKCLAW_DEEP_MODEL=sparkclaw-fast
SPARKCLAW_DEEP_MODEL_ID=nvidia/Qwen3.6-35B-A3B-NVFP4
SPARKCLAW_DEEP_SERVED_NAME=sparkclaw-deep
SPARKCLAW_DEEP_MAX_TOKENS=768
SPARKCLAW_DEEP_CONTEXT_TOKENS=32768
SPARKCLAW_DEEP_MAX_INPUT_TOKENS=0

SPARKCLAW_EMBEDDING_BASE_URL=http://sparkclaw-embedding:8003/v1
SPARKCLAW_EMBEDDING_MODEL=sparkclaw-embedding
SPARKCLAW_EMBEDDING_MAX_MODEL_LEN=8192
SPARKCLAW_EMBEDDING_GPU_MEMORY_UTILIZATION=0.06
SPARKCLAW_EMBEDDING_KV_CACHE_MEMORY_BYTES=2G
SPARKCLAW_EMBEDDING_MAX_NUM_SEQS=128

SPARKCLAW_GUARD_BASE_URL=http://sparkclaw-guard:8005/v1
SPARKCLAW_GUARD_MODEL=Qwen/Qwen3Guard-Gen-0.6B
SPARKCLAW_GUARD_MODEL_ID=Qwen/Qwen3Guard-Gen-0.6B
SPARKCLAW_GUARD_SERVED_NAME=Qwen/Qwen3Guard-Gen-0.6B
SPARKCLAW_GUARD_MAX_TOKENS=128
SPARKCLAW_GUARD_CONTEXT_TOKENS=16384
SPARKCLAW_GUARD_MAX_MODEL_LEN=16384
SPARKCLAW_GUARD_GPU_MEMORY_UTILIZATION=0.04
SPARKCLAW_GUARD_KV_CACHE_MEMORY_BYTES=2G
SPARKCLAW_GUARD_MAX_NUM_SEQS=1

SPARKCLAW_BROWSER_READ_ALLOW_HOSTS=host.docker.internal

SPARKCLAW_BENCH_PROFILE=single-fast-v1
SPARKCLAW_BENCH_LANES=fast
SPARKCLAW_BENCH_SCENARIOS=chat,summary,coding
SPARKCLAW_BENCH_REPEATS=2
