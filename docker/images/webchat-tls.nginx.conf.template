map $http_upgrade $sparkclaw_connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 18790 ssl;
  server_name _;
  resolver 127.0.0.11 valid=10s ipv6=off;
  server_tokens off;
  access_log off;
  ssl_certificate /run/sparkclaw/tls/server.crt;
  ssl_certificate_key /run/sparkclaw/tls/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  error_page 497 =308 https://$http_host$request_uri;

  # workbench Host admission requires TLS on the Gateway connection itself.
  proxy_ssl_verify on;
  proxy_ssl_trusted_certificate /run/sparkclaw/tls/ca.crt;
  proxy_ssl_server_name on;
  proxy_ssl_name gateway;
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $sparkclaw_connection_upgrade;
  proxy_buffering off;
  proxy_cache off;
  proxy_read_timeout 1h;
  proxy_send_timeout 1h;

  root /usr/share/nginx/html;
  index index.html;
  location / { try_files $uri $uri/ /index.html; }
  location /api/jingsi/ { return 404; }
  location /api/ {
    client_max_body_size 2m;
    proxy_pass https://gateway:18789$request_uri;
  }
  location /api/v1/inputs/ {
    client_max_body_size 8m;
    proxy_request_buffering off;
    proxy_pass https://gateway:18789$request_uri;
  }
  location = /api/v1/mail/attachments {
    client_max_body_size 10m;
    proxy_request_buffering off;
    proxy_pass https://gateway:18789$request_uri;
  }
  location = /mcp {
    proxy_request_buffering off;
    proxy_pass https://gateway:18789$request_uri;
  }
  location = /healthz { proxy_pass https://gateway:18789$request_uri; }
  location = /readyz { proxy_pass https://gateway:18789$request_uri; }
}

# Preserve the separately scoped JingSi presentation listener when published.
server {
  listen ${SPARKCLAW_JINGSI_LAN_PORT};
  server_name _;
  resolver 127.0.0.11 valid=10s ipv6=off;
  server_tokens off;
  access_log off;
  client_max_body_size 1025k;
  proxy_ssl_verify on;
  proxy_ssl_trusted_certificate /run/sparkclaw/tls/ca.crt;
  proxy_ssl_server_name on;
  proxy_ssl_name gateway;
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_request_buffering off;
  proxy_buffering off;
  proxy_cache off;
  proxy_read_timeout 1h;
  proxy_send_timeout 1h;

  location = /api/jingsi/v0/readyz {
    if ($request_method != GET) { return 405; }
    proxy_pass https://gateway:18789$request_uri;
  }
  location = /api/jingsi/v0/messages/stream {
    if ($request_method != POST) { return 405; }
    proxy_pass https://gateway:18789$request_uri;
  }
  location = /api/jingsi/v0/client-events/head {
    if ($request_method != GET) { return 405; }
    proxy_pass https://gateway:18789$request_uri;
  }
  location = /api/jingsi/v0/client-events {
    if ($request_method != GET) { return 405; }
    proxy_pass https://gateway:18789$request_uri;
  }
  location = /api/jingsi/v0/client-events/stream {
    if ($request_method != GET) { return 405; }
    proxy_pass https://gateway:18789$request_uri;
  }
  location / { return 404; }
}
