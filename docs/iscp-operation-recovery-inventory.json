  "families": {
    "execution": {
      "strategy": "Original request ID/input digest; durable never-attempted intent may submit under original deadline/authority. Attempted uncertain submit performs lookup; accepted/running attaches; terminal result saves locally before ACK; cancellation reconciles original desired state. No generic replay after a missing lookup.",
      "server": [
        "services/gateway/internal/execution/service.go",
        "services/gateway/internal/execution/workbench.go",
        "services/gateway/internal/gateway/workbench_iscp.go"
      ],
      "client": [
        "apps/desktop/src/main/execution-client.mjs",
        "apps/desktop/src/main/execution-progress.mjs",
        "apps/desktop/src/main/client-store.mjs"
      ],
      "planned_gaps": [
        "Wake reconciliation only after verified business READY; retain original request deadline/authority through reconnect. Qualify negative/missing admission and process-crash behavior; do not claim restored history from empty storage."
      ]
    },
    "domain_mutation": {
      "strategy": "Immutable operation ID + operation/params/expected revision/request ID/input digest/body; authenticated receipt lookup first after uncertainty. Completed receipt returns original result. Incomplete intent remains outcome_unknown; no repeat of external effect. Never-attempted new journal entries may submit original intent only under valid original deadline/authority.",
      "server": [
        "services/gateway/internal/gateway/workbench_iscp_domain.go",
        "services/gateway/internal/gateway/workbench_iscp_receipts.go"
      ],
      "client": [
        "apps/desktop/src/main/iscp-mutation-journal.mjs",
        "apps/desktop/src/main/iscp-transport.mjs"
      ],
      "planned_gaps": [
        "New encrypted immutable-intent journal with prepared/attempted/terminal/applied phases and enumeration. Current fingerprint-only resource journal cannot restore a never-sent intent or reconcile automatically at READY. Persist terminal response before local application acknowledgement; retain tombstones/history-coverage evidence; never silently delete unknown."
      ]
    },
    "mail": {
      "strategy": "Read current state independently. Mutations use durable original operation receipt and expected resource version. mail.send/mail.drafts.send retain provider reconciliation identity; accepted-but-unconfirmed delivery stays effect_unknown until mail.drafts.reconcile/resolve proves disposition. Login/browser/provider effects are not automatically restarted. Attachment transfers may restage immutable bytes without executing the mail action.",
      "server": [
        "services/gateway/internal/gateway/workbench_iscp_mail.go",
        "services/gateway/internal/gateway/workbench_iscp_mail_popup.go",
        "services/gateway/internal/gateway/workbench_iscp_mail_providers.go"
      ],
      "client": [
        "apps/desktop/src/main/iscp-transport.mjs",
        "apps/desktop/src/main/iscp-mail-attachments.mjs"
      ],
      "planned_gaps": [
        "Use protected intent/result journal and READY enumeration for all admitted mail mutations; do not store mail bodies or credentials in plaintext. Preserve user draft on unknown or expired authority."
      ]
    },
    "objects": {
      "strategy": "Resume same transfer/object identity and immutable byte digest with transfer.status/open/chunk/commit idempotency and durable checkpoints. Object reads verify version/digest. Expired object may restage source bytes as a new transfer, but cannot change or repeat its parent business operation.",
      "server": [
        "services/gateway/internal/iscpobjects/store.go",
        "services/gateway/internal/gateway/workbench_iscp_objects.go"
      ],
      "client": [
        "apps/desktop/src/main/iscp-object-client.mjs"
      ],
      "planned_gaps": [
        "Qualify expired-transfer metadata retention separately from business deduplication; reconnect never resets parent execution deadline."
      ]
    },
    "events": {
      "strategy": "Persist cursor/snapshot before ACK. Same epoch resumes; gap/expired cursor fetches authoritative snapshot. Event invalidations wake original-ID execution lookup; they never admit execution. Replacement session uses fresh subscription IDs and envelopes.",
      "server": [
        "services/gateway/internal/gateway/workbench_iscp_events.go"
      ],
      "client": [
        "apps/desktop/src/main/iscp-event-client.mjs"
      ],
      "planned_gaps": [
        "READY wake and stale-generation tests must cover snapshot commit/ACK races without wiping prior projection."
      ]
    },
    "browser": {
      "strategy": "Original command ID and receipt/reconcile govern uncertain host commands. Host grant/register/close/revoke require their original operation receipt and current permission. Heartbeats are session sequence state and are not replayed into a new host generation.",
      "server": [
        "services/gateway/internal/gateway/workbench_iscp_browser.go",
        "services/gateway/internal/browsercontrol/lifecycle.go"
      ],
      "client": [
        "apps/desktop/src/browser/iscp-host-channel.mjs"
      ],
      "planned_gaps": [
        "Cross-check host process loss and already-dispatched effects; no automatic second browser action after an unknown receipt."
      ]
    },
    "realtime_media": {
      "strategy": "Fresh authorization/session generation plus original session/frame sequence bounds; do not replay audio frames into a replaced stream. Durable transcribe/finish/cancel receipts reconcile existing operations. Preview lifetime cannot extend parent execution.",
      "server": [
        "services/gateway/internal/gateway/workbench_iscp_speech.go",
        "services/gateway/internal/iscpworkbench/endpoint_stream.go"
      ],
      "client": [
        "apps/desktop/src/main/iscp-audio-client.mjs",
        "apps/desktop/src/main/iscp-recording-client.mjs"
      ],
      "planned_gaps": [
        "Qualify same-session refresh versus actual session loss, uncertain terminal receipt and original recording retention."
      ]
    },
    "client_management": {
      "strategy": "Issuer-owned sealed issue/revoke receipts under original opaque operation ID; protected client operation vault. Delete remains idempotent with owner checks. Reconnect cannot mint another invitation or client.",
      "server": [
        "services/gateway/internal/gateway/workbench_iscp_clients.go"
      ],
      "client": [
        "apps/desktop/src/main/iscp-transport.mjs",
        "apps/desktop/src/main/secure-credential-store.mjs"
      ],
      "planned_gaps": [
        "Audit disposition before vault clearing and recover pending operations at business READY. Never move credential results into plaintext domain journals."
      ]
    },
    "authorization_management": {
      "strategy": "Signed authority state and durable deletion/revocation receipt; automatic recovery stops only on verified current terminal authority. Deletion keeps original operation ID and effect fence.",
      "server": [
        "services/gateway/internal/gateway/workbench_iscp_authorizations.go",
        "services/gateway/internal/iscpworkbench/authorization_control.go"
      ],
      "client": [
        "apps/desktop/src/main/iscp-transport.mjs"
      ],
      "planned_gaps": [
        "Qualify deletion versus renewal and delayed READY/generation events; preserve original identity material when ordinary authentication is unresolved."
      ]
    },
    "read_and_binding": {
      "strategy": "Recompute current authorized reads; this is not reconstruction of an old snapshot. installation.bind remains original binding with durable idempotency and cannot replace device/client. Original schemas and trusted-session authorization policy remain enforced.",
      "server": [
        "services/gateway/internal/gateway/workbench_iscp.go",
        "services/gateway/internal/gateway/workbench_iscp_domain.go"
      ],
      "client": [
        "apps/desktop/src/main/iscp-transport.mjs"
      ],
      "planned_gaps": [
        "Keep unrelated reads enabled when one mutation outcome is unknown; capabilities need verified business READY."
      ]
    }
