{
  "name": "sparkclaw",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable local agent runtime for DGX Spark.",
  "license": "Apache-2.0",
  "author": "SparkClaw contributors",
  "homepage": "https://github.com/Chiiz0/SparkClaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chiiz0/SparkClaw.git"
  },
  "bugs": {
    "url": "https://github.com/Chiiz0/SparkClaw/issues"
  },
  "keywords": [
    "agent",
    "local-first",
    "dgx-spark",
    "llm",
    "workflow",
    "tool-calling"
  ],
  "workspaces": [
    "apps/webchat",
    "tools/document-runtime"
  ],
  "dependencies": {
    "agent-browser": "0.32.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "exceljs": {
      "archiver": "^8.0.0",
      "unzipper": "^0.12.5",
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "npm run runtime:restart",
    "dev:gateway": "bash scripts/restart_runtime_compose.sh gateway",
    "dev:webchat": "bash scripts/restart_runtime_compose.sh webchat",
    "dev:gateway:host": "go run ./services/gateway/cmd/sparkclaw -config configs/sparkclaw.default.json",
    "dev:webchat:host": "npm --workspace @sparkclaw/webchat run dev",
    "build:webchat": "npm --workspace @sparkclaw/webchat run build",
    "test:webchat": "npm --workspace @sparkclaw/webchat run test",
    "setup:browser": "bash scripts/setup-browser.sh",
    "setup:host": "npm run setup:document-tools && npm run setup:browser",
    "test:gateway": "go test ./services/gateway/...",
    "doctor": "bash scripts/doctor.sh",
    "setup:document-tools": "bash scripts/setup-document-tools.sh",
    "eval": "bash scripts/run-eval.sh",
    "runtime:restart": "bash scripts/restart_runtime_compose.sh",
    "build": "npm run build:webchat && npm run test:gateway"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "allowScripts": {
    "agent-browser@0.32.3": true
  }
}
