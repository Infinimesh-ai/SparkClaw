{
  "name": "sparkclaw",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable local agent runtime for DGX Spark.",
  "license": "Apache-2.0",
  "author": "SparkClaw contributors",
  "homepage": "https://github.com/Infinimesh-ai/SparkClaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infinimesh-ai/SparkClaw.git"
  },
  "bugs": {
    "url": "https://github.com/Infinimesh-ai/SparkClaw/issues"
  },
  "keywords": [
    "agent",
    "local-first",
    "dgx-spark",
    "llm",
    "workflow",
    "tool-calling"
  ],
  "workspaces": [
    "apps/desktop",
    "apps/webchat",
    "tools/browser-bridge",
    "tools/document-runtime"
  ],
  "dependencies": {},
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "3.3.19",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.12"
    },
    "exceljs": {
      "archiver": "^8.0.0",
      "unzipper": "^0.12.5",
      "uuid": "^11.1.1"
    },
    "undici@7": "7.29.1"
  },
  "scripts": {
    "deploy:local": "bash scripts/deploy_local.sh",
    "start:local": "bash scripts/start_local_compose.sh",
    "deploy:remote": "bash scripts/deploy_remote.sh",
    "start:remote": "bash scripts/start_remote_compose.sh",
    "autostart:install": "bash scripts/install_autostart_systemd.sh",
    "dev:gateway:host": "go run ./services/gateway/cmd/sparkclaw -config configs/sparkclaw.default.json",
    "dev:desktop": "npm --workspace @sparkclaw/desktop run dev",
    "install:desktop-launcher": "bash scripts/install-desktop-launcher.sh",
    "dev:webchat:host": "npm --workspace @sparkclaw/webchat run dev",
    "test:desktop": "npm --workspace @sparkclaw/desktop run test",
    "qualify:desktop": "npm --workspace @sparkclaw/desktop run qualify",
    "build:desktop-managed-scripts": "node scripts/build-desktop-managed-preload.mjs",
    "check:desktop-managed-scripts": "node scripts/build-desktop-managed-preload.mjs --check",
    "package:desktop": "npm run build:webchat && npm run check:desktop-managed-scripts && npm --workspace @sparkclaw/desktop run dist:linux-arm64 && node scripts/write-desktop-release-manifest.mjs",
    "qualify:desktop-artifacts": "node scripts/qualify-desktop-artifacts.mjs",
    "qualify:local-shared-backend": "bash scripts/qualify-local-shared-backend.sh",
    "build:webchat": "npm --workspace @sparkclaw/webchat run build",
    "test:webchat": "npm --workspace @sparkclaw/webchat run test",
    "test:email-scripts": "node --test tools/browser-controller/test/provider-script-contract.test.mjs",
    "setup:browser": "bash scripts/setup-browser.sh",
    "setup:browser-controller": "bash scripts/setup-browser-controller.sh",
    "check:browser-controller": "bash scripts/setup-browser-controller.sh --check",
    "open:browser": "bash scripts/open-browser.sh",
    "qualify:playwright-email": "bash scripts/qualify-playwright-email.sh",
    "setup:host": "npm run setup:document-tools && npm run setup:browser",
    "test:gateway": "go test ./services/gateway/...",
    "doctor": "bash scripts/doctor.sh",
    "setup:document-tools": "bash scripts/setup-document-tools.sh",
    "eval": "bash scripts/run-eval.sh",
    "build": "npm run build:webchat && npm run test:gateway",
    "qualify:app-cli-release": "python3 scripts/qualify-app-cli-release.py",
    "sync:app-cli-projections": "node scripts/sync-app-cli-projections.mjs",
    "check:app-cli-projections": "node scripts/sync-app-cli-projections.mjs --check"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
