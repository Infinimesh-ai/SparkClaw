{
  "name": "sparkclaw",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable local agent runtime for DGX Spark.",
  "license": "Apache-2.0",
  "author": "SparkClaw contributors",
  "homepage": "https://github.com/Infinimesh-ai/SparkClaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infinimesh-ai/SparkClaw.git"
  },
  "bugs": {
    "url": "https://github.com/Infinimesh-ai/SparkClaw/issues"
  },
  "keywords": [
    "agent",
    "local-first",
    "dgx-spark",
    "llm",
    "workflow",
    "tool-calling"
  ],
  "workspaces": [
    "apps/webchat",
    "tools/document-runtime"
  ],
  "dependencies": {
    "agent-browser": "0.32.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "exceljs": {
      "archiver": "^8.0.0",
      "unzipper": "^0.12.5",
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "deploy": "bash scripts/deploy.sh",
    "start": "bash scripts/start_compose.sh",
    "autostart:install": "bash scripts/install_autostart_systemd.sh",
    "dev": "npm run runtime:restart:online",
    "dev:gateway": "npm run dev:gateway:online",
    "dev:gateway:online": "bash scripts/restart_runtime_compose.sh online gateway",
    "dev:gateway:local": "bash scripts/restart_runtime_compose.sh local gateway",
    "dev:webchat": "npm run dev:webchat:online",
    "dev:webchat:online": "bash scripts/restart_runtime_compose.sh online webchat",
    "dev:webchat:local": "bash scripts/restart_runtime_compose.sh local webchat",
    "dev:gateway:host": "go run ./services/gateway/cmd/sparkclaw -config configs/sparkclaw.default.json",
    "dev:webchat:host": "npm --workspace @sparkclaw/webchat run dev",
    "build:webchat": "npm --workspace @sparkclaw/webchat run build",
    "test:webchat": "npm --workspace @sparkclaw/webchat run test",
    "setup:browser": "bash scripts/setup-browser.sh",
    "setup:host": "npm run setup:document-tools && npm run setup:browser",
    "test:gateway": "go test ./services/gateway/...",
    "doctor": "bash scripts/doctor.sh",
    "setup:document-tools": "bash scripts/setup-document-tools.sh",
    "eval": "bash scripts/run-eval.sh",
    "runtime:restart": "npm run runtime:restart:online",
    "runtime:restart:online": "bash scripts/restart_runtime_compose.sh online",
    "runtime:restart:local": "bash scripts/restart_runtime_compose.sh local",
    "build": "npm run build:webchat && npm run test:gateway"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "allowScripts": {
    "agent-browser@0.32.3": true
  }
}
