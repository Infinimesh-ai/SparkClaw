{
  "name": "sparkclaw",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable local agent runtime for DGX Spark.",
  "license": "Apache-2.0",
  "author": "SparkClaw contributors",
  "homepage": "https://github.com/Chiiz0/SparkClaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chiiz0/SparkClaw.git"
  },
  "bugs": {
    "url": "https://github.com/Chiiz0/SparkClaw/issues"
  },
  "keywords": [
    "agent",
    "local-first",
    "dgx-spark",
    "llm",
    "workflow",
    "tool-calling"
  ],
  "workspaces": [
    "apps/webchat"
  ],
  "scripts": {
    "dev:webchat": "npm --workspace @sparkclaw/webchat run dev",
    "build:webchat": "npm --workspace @sparkclaw/webchat run build",
    "test:gateway": "go test ./services/gateway/...",
    "doctor": "bash scripts/doctor.sh",
    "eval": "bash scripts/run-eval.sh",
    "build": "npm run build:webchat && npm run test:gateway"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
