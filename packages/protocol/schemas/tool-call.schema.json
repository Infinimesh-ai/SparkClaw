{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkclaw.local/schemas/tool-call.schema.json",
  "title": "SparkClaw Tool Call",
  "type": "object",
  "required": ["id", "session_id", "run_id", "tool", "risk", "status", "arguments", "started_at"],
  "properties": {
    "id": { "type": "string" },
    "session_id": { "type": "string" },
    "run_id": { "type": "string" },
    "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
    "risk": { "enum": ["read", "draft", "reversible", "dangerous"] },
    "status": {
      "enum": [
        "started",
        "completed",
        "failed",
        "blocked",
        "approval_pending",
        "running_after_approval",
        "completed_after_approval",
        "failed_after_approval",
        "rejected",
        "repaired"
      ]
    },
    "arguments": { "type": "object" },
    "result": true,
    "error": { "type": "string" },
    "approval_id": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "observation_ref": { "type": "string" },
    "observation_summary": { "type": "string" }
  },
  "additionalProperties": false
}
