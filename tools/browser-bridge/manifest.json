{
  "manifest_version": 3,
  "name": "SparkClaw Browser Bridge",
  "version": "1.0.18",
  "description": "Connects bounded SparkClaw tasks to task-owned browser tabs.",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/bootstrap-1.0.18.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "SparkClaw Browser Bridge"
  },
  "key": ""
}
