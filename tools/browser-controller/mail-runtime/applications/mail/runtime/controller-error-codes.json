    "browser_controller_unavailable": { "gateway_code": "browser_controller_unavailable", "gateway_retryable": true },
    "browser_extension_rejected": { "gateway_code": "browser_extension_rejected", "gateway_retryable": false },
    "browser_extension_unavailable": { "gateway_code": "browser_extension_unavailable", "gateway_retryable": true },
    "browser_lane_unavailable": { "gateway_code": "browser_operation_unavailable", "gateway_retryable": false },
    "browser_operation_unavailable": { "gateway_code": "browser_operation_unavailable", "gateway_retryable": false },
    "browser_page_stale": { "gateway_code": "browser_page_stale", "gateway_retryable": false },
    "browser_script_timeout": { "gateway_code": "browser_script_timeout", "gateway_retryable": true },
    "browser_script_unavailable": { "gateway_code": "browser_script_unavailable", "gateway_retryable": false },
    "browser_session_invalid": { "gateway_code": "browser_session_stale", "gateway_retryable": false },
    "browser_session_not_found": { "gateway_code": "browser_session_not_found", "gateway_retryable": false },
    "browser_session_stale": { "gateway_code": "browser_session_stale", "gateway_retryable": false },
