{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installed execution binding 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "manifest",
    "manifest_digest",
    "commands"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "application": {
      "type": "object"
    },
    "manifest": {
      "type": "object"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "handler"
        ],
        "properties": {
          "handler": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "renewable": {
            "type": "boolean"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800000
          },
          "script_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "source_checksum": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "reconcile_requires_host": {
            "type": "boolean"
          },
          "host": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "methods",
              "page"
            ],
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "activity": {
                "enum": [
                  "read",
                  "watch",
                  "exclusive"
                ]
              },
              "reuse_idle_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1800000
              },
              "invalidate_on_failure": {
                "type": "boolean"
              },
              "methods": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "page": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
