{
  "name": "sparkclaw-browser-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Owner-scoped host controller for Playwright Extension browser sessions.",
  "license": "Apache-2.0",
  "bin": {
    "sparkclaw-browser-controller": "./src/main.mjs"
  },
  "scripts": {
    "pretest": "node ./src/install-playwright-downloads.mjs",
    "postinstall": "node ./src/install-playwright-downloads.mjs",
    "start": "node ./src/main.mjs",
    "test": "node --test test/*.test.mjs",
    "sync:provider-contract": "node ./src/provider-script-contract.mjs --write",
    "check:provider-contract": "node ./src/provider-script-contract.mjs --check"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "@infinimesh/app-cli-runtime": "file:../../vendor/app-cli/infinimesh-app-cli-runtime-0.3.0-sparkclaw.41.tgz",
    "@playwright/cli": "0.1.23",
    "@playwright/mcp": "0.0.85",
    "playwright": "1.65.1",
    "playwright-core": "1.65.1"
  },
  "overrides": {
    "playwright": "$playwright",
    "playwright-core": "$playwright-core"
  }
}
