// Build inside services/gateway so internal imports remain restricted. This
// operator helper speaks only to its parent process, never a terminal/log.
package main

import (
	"bufio"
	"context"
	"encoding/json"
	"fmt"
	"github.com/Chiiz0/SparkClaw/services/gateway/internal/browsercontrol"
	"github.com/Chiiz0/SparkClaw/services/gateway/internal/config"
	"github.com/Chiiz0/SparkClaw/services/gateway/internal/credential"
	"github.com/Chiiz0/SparkClaw/services/gateway/internal/store"
	"github.com/jackc/pgx/v5"
	"os"
	"time"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, "diagnostic_reservation_failed")
		os.Exit(1)
	}
}
func run() (result error) {
	if len(os.Args) != 1 || os.Getenv("SPARKCLAW_FIXED_OUTLOOK_DIAGNOSTIC") != "1" {
		return fmt.Errorf("opt-in required")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Minute)
	defer cancel()
	cfg, err := config.Load("/app/configs/sparkclaw.default.json")
	if err != nil {
		return err
	}
	rt, err := store.NewRuntime(ctx, store.RuntimeOptions{Backend: store.BackendPostgres, PostgresDSN: cfg.State.DSN})
	if err != nil {
		return err
	}
	defer rt.Close(context.Background())
	vault := credential.New(rt.CredentialRepository(), credential.Options{Key: cfg.State.CredentialKey, KeyFile: cfg.State.CredentialKeyFile})
	ec := cfg.Adapters.BrowserAutomation.PlaywrightExtension
	client, err := browsercontrol.NewHTTPControllerClient(ec.ControllerSocket, 75*time.Second)
	if err != nil {
		return err
	}
	defer client.Close()
	control := browsercontrol.New(vault, client, ec.ProfileID)
	control.Initialize(ctx)
	session, err := control.AcquireSession(ctx, "fixed-empty-outlook-menu-diagnostic", 30*time.Second, 7*time.Minute)
	if err != nil {
		return err
	}
	cleanupProven := true // No private Driver exists until the parent receives the bootstrap.
	defer func() {
		if err := finishReservation(session.Lease().ExpiresAt, cleanupProven, session.Release); err != nil {
			result = err
		}
	}()
	token, _, found, err := vault.OpenBindingVersion(ctx, "browser-control:playwright-extension:default", "playwright-extension-token-v1")
	if err != nil || !found {
		return fmt.Errorf("binding unavailable")
	}
	defer clear(token)
	db, err := pgx.Connect(ctx, cfg.State.DSN)
	if err != nil {
		return err
	}
	defer db.Close(context.Background())
	var account string
	err = db.QueryRow(ctx, `SELECT m.payload->>'address' FROM email_management_records d JOIN email_management_records m ON m.kind='mailbox' AND m.id=d.payload->>'mailbox_id' AND m.owner_id=d.owner_id WHERE d.kind='draft' AND d.id='34b28df2-f9c4-405c-8822-744229cb26f8'`).Scan(&account)
	if err != nil || account == "" {
		return fmt.Errorf("approved mailbox unavailable")
	}
	// Private pipe consumed by the fixed harness; it emits no credentials.
	if err = json.NewEncoder(os.Stdout).Encode(map[string]any{"token": string(token), "account": account, "reservation": true}); err != nil {
		return err
	}
	cleanupProven = false
	done := make(chan string, 1)
	go func() {
		scan := bufio.NewScanner(os.Stdin)
		if scan.Scan() {
			done <- scan.Text()
		} else {
			done <- "eof"
		}
	}()
	select {
	case value := <-done:
		if value != "release" {
			return fmt.Errorf("parent lost")
		}
		cleanupProven = true
	case <-ctx.Done():
		return ctx.Err()
	}
	return nil
}

// A private cleanup failure or parent EOF never proves that releasing the
// production slot is safe. Retain it until its original bounded expiration,
// report the unresolved cleanup, and never claim successful release.
func finishReservation(expires time.Time, cleanupProven bool, release func(context.Context) error) error {
	if !cleanupProven {
		fmt.Fprintln(os.Stderr, "reservation_cleanup_required")
		if remaining := time.Until(expires); remaining > 0 {
			timer := time.NewTimer(remaining)
			defer timer.Stop()
			<-timer.C
		}
		return fmt.Errorf("reservation_cleanup_unproven")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
	defer cancel()
	if release(ctx) != nil {
		fmt.Fprintln(os.Stderr, "reservation_release_failed")
		return fmt.Errorf("reservation_release_failed")
	}
	return nil
}
