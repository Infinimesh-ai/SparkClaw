+
+
+class ClientBuildTests(unittest.TestCase):
+    def test_verified_request_records_actual_binary_build_and_rejects_bad_signature(self):
+        for build in (BUILD, BUILD_70451):
+            with self.subTest(build=build), patch('ezmcd.accounts.constants',
+                    return_value=ClientConstants(KEYS, build)):
+                result=profile_from_balance_sample(sample(), 'unused')
+                self.assertEqual(result['build_sha256'], build)
+                altered=sample();altered['request']['headers']['token']='different-device'
+                with self.assertRaisesRegex(EzMcdError, 'invalid_official_sample_signature'):
+                    profile_from_balance_sample(altered, 'unused')
+
+    def test_enrollment_rejects_other_pinned_binary_before_wallet_or_account_write(self):
+        with patch('ezmcd.accounts.constants', return_value=ClientConstants(KEYS, BUILD)):
+            profile=profile_from_balance_sample(sample(), 'unused')
+        with tempfile.TemporaryDirectory() as tmp, patch('ezmcd.accounts.constants',
+                return_value=ClientConstants(KEYS, BUILD_70451)), \
+                patch('ezmcd.provider.McdProvider.wallet') as wallet:
+            store=Store(Path(tmp))
+            with self.assertRaisesRegex(EzMcdError, 'official_client_profile_build_mismatch'):
+                _enroll(store, 'mine', profile, 'unused', None, None, check_live=True)
+            self.assertEqual(store.accounts(), [])
+            wallet.assert_not_called()
+
+    def test_device_recovery_never_treats_distinct_builds_as_same_context(self):
+        record={'profile':{'build_sha256':BUILD,
+            'client_headers':{'ct':'101','v':'synthetic','language':'zh'},
+            'fields':{'deviceToken':'synthetic-device','riskDeviceId':'synthetic-risk'}}}
+        current=deepcopy(record);current['profile']['build_sha256']=BUILD_70451
+        self.assertIsNotNone(device_context(current))
+        self.assertNotEqual(device_context(record),device_context(current))
+        current['profile']['build_sha256']='unknown'
+        self.assertIsNone(device_context(current))
+
+    def test_unknown_binary_is_rejected_before_material_addresses_are_read(self):
+        image=Mock(blob=b'unknown synthetic binary')
+        with patch('ezmcd.protocol.signing.MachO', return_value=image):
+            with self.assertRaisesRegex(EzMcdError,'official_client_build_not_supported'):
+                _constants.__wrapped__('unused',0,0)
+        image.read.assert_not_called();image.describe.assert_not_called()
+
+    def test_material_uses_only_layout_selected_by_complete_binary_digest(self):
+        blob=b'synthetic pinned binary';digest=hashlib.sha256(blob).hexdigest()
+        image=Mock(blob=blob)
+        access,secret,table,wallet=1,2,3,(4,5,6)
+        encoded=lambda value,delta:bytes(v^((i-delta)&255) for i,v in enumerate(value))
+        materials={access:encoded(b'A'*20,5),secret:encoded(b'S'*40,29),table:bytes(256)}
+        image.read.side_effect=lambda address,size:materials[address]
+        image.describe.side_effect=lambda address:{4:'synthetic-app',5:'synthetic-version',6:'synthetic-key'}[address]
+        with patch('ezmcd.protocol.signing.MachO',return_value=image), \
+                patch.dict('ezmcd.protocol.signing.BUILD_LAYOUTS',{digest:(access,secret,table,wallet)},clear=True):
+            result=_constants.__wrapped__('unused',0,0)
+        self.assertEqual(result.build_sha256,digest)
+        self.assertEqual(result[:2],('A'*20,'S'*40))
+        self.assertNotIn('S'*40,repr(result))
+        self.assertEqual(result[3],('synthetic-app','synthetic-version','synthetic-key'))
+
+    def test_new_build_sms_encryption_stops_before_reading_old_key_address(self):
+        with patch('ezmcd.protocol.login.constants',return_value=ClientConstants(KEYS,BUILD_70451)), \
