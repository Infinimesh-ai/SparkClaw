+        !/^[a-f0-9]{2}$/u.test(components[1]) || components[2] !== item.name)) throw invalid();
+    total += item.size_bytes;
+    if (total > ATTACHMENT_BYTES) throw fail('email_attachment_limit');
+    if (item.path) paths.add(item.path);
