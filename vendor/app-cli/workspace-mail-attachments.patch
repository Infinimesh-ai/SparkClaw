+  let total = 0;
+  const paths = new Set();
+  return value.map(item => {
+    if (!item || Object.keys(item).sort().join(',') !== 'name,path,sha256,size_bytes' ||
+        typeof item.name !== 'string' || !item.name || Buffer.byteLength(item.name) > 255 ||
